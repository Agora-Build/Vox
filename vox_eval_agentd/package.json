{
  "name": "vox_eval_agentd",
  "version": "1.0.0",
  "description": "Vox Evaluation Agent Daemon - integrates aeval with Vox API",
  "type": "module",
  "main": "vox-agentd.js",
  "scripts": {
    "build": "esbuild vox-agentd.ts --bundle --platform=node --format=esm --outfile=vox-agentd.js --external:@aws-sdk/client-s3 --external:ws",
    "start": "node vox-agentd.js"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^3.25.76",
    "@aws-sdk/client-s3": "^3.700.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "keywords": [
    "vox",
    "evaluation",
    "voice-agent",
    "testing"
  ],
  "license": "MIT"
}
